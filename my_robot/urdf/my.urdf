<?xml version="1.0"?>
<robot name="my">
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://my_robot/meshes/base.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="custom_color">
        <color rgba="1.0 1.0 1.0 1.0"/>  <!-- white-->
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <link name="link0">
    <visual>
      <geometry>
        <mesh filename="package://my_robot/meshes/joint1.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <origin xyz="0.0 0.0 1.6" rpy='0 0 3.1415'/>
      <material name="custom_color">
        <color rgba="1.0 1.0 1.0 1.0"/>  <!-- white-->
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.15"/>
      </geometry>
      <origin xyz="0 0 1.6" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0.8" rpy="0 0 0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="base_to_link0" type="revolute">
    <parent link="base_link"/>
    <child link="link0"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.0 0.0 0.0" rpy='0 0 0'/>
    <limit
        lower="-4.0"
        upper="0"
        effort="100"
        velocity="1"/>
  </joint>

  <link name="link1">
    <visual>
      <geometry>
        <mesh filename="package://my_robot/meshes/joint2.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy='0 3.1415 1.5707'/>
      <material name="custom_color">
        <color rgba="1.0 1.0 1.0 1.0"/>  <!-- white-->
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.06 0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.7"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="link0_to_link1" type="revolute">
    <parent link="link0"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.0 0.0 1.6" rpy='-1.5707 3.1415 0'/>
    <limit
        lower="0.0"
        upper="3.1415"
        effort="100"
        velocity="1"/>
  </joint>

  <link name="link2">
    <visual>
      <geometry>
        <mesh filename="package://my_robot/meshes/joint3.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy='0 3.1415 0'/>
      <material name="custom_color">
        <color rgba="1.0 1.0 1.0 1.0"/>  <!-- white-->
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.06 0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="link1_to_link2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <origin xyz="1.7 0.0 0.0" rpy = '0 0 0'/>
    <limit
        lower="-3.1415"
        upper="0.0"
        effort="100"
        velocity="1"/>
  </joint>

  <link name="link3">
    <visual>
      <geometry>
        <mesh filename="package://my_robot/meshes/joint4.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <origin xyz="0.0 0.0 0.2" rpy='0 0 -1.5708'/>
      <material name="custom_color">
        <color rgba="1.0 1.0 1.0 1.0"/>  <!-- white-->
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.12 0.05 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="link2_to_link3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.0 0.7 0.0" rpy = '-1.5708 0 1.5708'/>
    <limit
        lower="-3.1415"
        upper="0.0"
        effort="100"
        velocity="1"/>
  </joint>

  <link name="link4">
    <visual>
      <geometry>
        <mesh filename="package://my_robot/meshes/joint5.STL" scale="0.01 0.01 0.01"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy='0 0 -3.14'/>
      <material name="custom_color">
        <color rgba="1.0 1.0 1.0 1.0"/>  <!-- white-->
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.10 0.04 0.04"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <joint name="link3_to_link4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.0 0.0 1.1" rpy = '0 -1.5707 -1.5707'/>
    <limit
        lower="-1.5714"
        upper="1.5714"
        effort="100"
        velocity="1"/>
  </joint>

  <link name="link5">
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="link4_to_link5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.9 0.0 0.0" rpy = '0 1.5707 0'/>
    <limit
        lower="0.0"
        upper="6.0"
        effort="100"
        velocity="1"/>
  </joint>

  <!-- Camera link - physical camera body -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="camera_color">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Camera optical frame - ROS convention: +z forward, +x right, +y down -->
  <link name="camera_link_optical"/>

  <!-- Fixed joint from link5 to camera_link -->
  <joint name="link5_to_camera" type="fixed">
    <parent link="link5"/>
    <child link="camera_link"/>
    <origin xyz="0.0 0.406 0.39" rpy="0 0 0"/>
  </joint>

  <!-- Fixed joint from camera_link to optical frame -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="0 0 3.1415"/>
  </joint>

  <!-- Gazebo camera sensor plugin -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera_sensor">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <topic>camera_sensor</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>
</robot>
