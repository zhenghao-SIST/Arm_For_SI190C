<?xml version="1.0"?>
<sdf version="1.8">
  <model name="aruco_marker">
    <static>true</static>
    <link name="marker_link">
      <pose>0 0 0 0 0 0</pose>
      <visual name="marker_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 0.001 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/aruco_marker.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- Invisible collision box (thin) so camera can see through it -->
      <collision name="marker_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 0.001 0.15</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
