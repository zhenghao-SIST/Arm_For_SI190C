    <!-- Joint state publisher: publishes joint states on gz-transport -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- Direct joint position plugins: instant position reset, no PID, no physics.
         Uses JointPositionReset + JointVelocityReset to snap the joint
         to the commanded position with zero velocity in a single step. -->
    <plugin
      filename="libDirectJointPositionPlugin.so"
      name="my::DirectJointPositionPlugin">
      <joint_name>base_to_link0</joint_name>
    </plugin>
    <plugin
      filename="libDirectJointPositionPlugin.so"
      name="my::DirectJointPositionPlugin">
